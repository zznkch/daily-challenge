# ─────────────────────────────────────────────
# Daily Challenge — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────

# --- Database (REQUIRED as of Phase 2) ---
# PostgreSQL connection string. Free options: Neon, Supabase, Railway.
# After setting this, run: npm run db:migrate
DATABASE_URL="postgresql://user:password@localhost:5432/daily_challenge"

# --- Transactional email (password reset) ---
# Optional. If left blank, password reset links are logged to the server
# console instead of emailed — fine for local development, not for production.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@dailychallenge.app"

# --- Public app config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Advertising (Phase 7, optional) ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# --- Premium / Payments (Phase 7, optional — do not enable without real keys) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
