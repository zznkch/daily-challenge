# ─────────────────────────────────────────────
# Daily Challenge — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────

# --- Database (Phase 2+) ---
# PostgreSQL connection string. Free options: Neon, Supabase, Railway.
DATABASE_URL="postgresql://user:password@localhost:5432/daily_challenge"

# --- Auth.js / NextAuth (Phase 2) ---
# The canonical URL of your deployment.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- OAuth providers (optional, add only the ones you enable) ---
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (password reset, notifications) (Phase 2/6) ---
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@dailychallenge.app"

# --- Public app config ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Advertising (Phase 7, optional) ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# --- Premium / Payments (Phase 7, optional — do not enable without real keys) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
